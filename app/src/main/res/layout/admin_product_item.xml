<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_background"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="4dp"
    android:padding="14dp">

    <!-- Product name -->
    <TextView
        android:id="@+id/adminProductName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Nombre"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#1A1A1A"
        android:maxLines="2"
        android:ellipsize="end"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/adminEditButton" />

    <!-- Category badge -->
    <TextView
        android:id="@+id/adminProductCategory"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:text="Manga"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:paddingHorizontal="8dp"
        android:background="@drawable/category_badge"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/adminProductName"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Price -->
    <TextView
        android:id="@+id/adminProductPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="$0.00"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FF9500"
        android:layout_marginTop="4dp"
        android:layout_marginStart="8dp"
        app:layout_constraintTop_toBottomOf="@id/adminProductName"
        app:layout_constraintStart_toEndOf="@id/adminProductCategory"
        app:layout_constraintBaseline_toBaselineOf="@id/adminProductCategory" />

    <!-- Stock -->
    <TextView
        android:id="@+id/adminProductStock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Stock: 0"
        android:textSize="12sp"
        android:textColor="#666666"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/adminProductCategory"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Edit button -->
    <Button
        android:id="@+id/adminEditButton"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:text="Editar"
        android:textSize="12sp"
        android:textColor="#FFFFFF"
        android:background="@drawable/button_primary_background"
        android:paddingHorizontal="12dp"
        android:layout_marginStart="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/adminDeleteButton" />

    <!-- Delete button -->
    <Button
        android:id="@+id/adminDeleteButton"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:text="Borrar"
        android:textSize="12sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#F44336"
        android:paddingHorizontal="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
