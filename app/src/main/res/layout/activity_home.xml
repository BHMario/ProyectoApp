<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/backgroundColor">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="24dp"
        android:background="@drawable/header_gradient"
        android:elevation="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MangUP"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/welcomeTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bienvenido, Usuario"
            android:textSize="14sp"
            android:textColor="@color/primaryOrange"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <!-- Contenido Principal -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="24dp">

            <!-- Acerca De -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_background"
                android:padding="20dp"
                android:layout_marginBottom="16dp">

                <TextView
                    style="@style/TextHeading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Acerca de MangUP"
                    android:textColor="@color/primaryOrange"
                    android:layout_marginBottom="12dp" />

                <TextView
                    style="@style/TextBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="MangUP es tu ecommerce especializado en manga, figuras coleccionables y merchandising anime. Nos apasiona traerte los mejores productos del anime y manga japonés con la mejor calidad y los precios más competitivos."
                    android:layout_marginBottom="16dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/lightGray"
                    android:layout_marginVertical="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="✓ Envíos rápidos y seguros"
                    android:textSize="14sp"
                    android:textColor="@color/success"
                    android:layout_marginVertical="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="✓ Productos 100% originales"
                    android:textSize="14sp"
                    android:textColor="@color/success"
                    android:layout_marginVertical="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="✓ Atención al cliente disponible"
                    android:textSize="14sp"
                    android:textColor="@color/success"
                    android:layout_marginVertical="4dp" />
            </LinearLayout>

            <!-- Titulo Sección Productos -->
            <TextView
                style="@style/TextHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="¿Qué ofrecemos?"
                android:textColor="@color/textPrimary"
                android:layout_marginBottom="16dp"
                android:layout_marginTop="8dp" />

            <!-- Manga -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/card_background"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextHeading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Manga"
                        android:textSize="18sp"
                        android:textColor="@color/primaryOrange"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        style="@style/TextCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Una amplia selección de manga en español de todos los géneros: shonen, shoujo, seinen, y más."
                        android:textColor="@color/textSecondary"
                        android:lineSpacingMultiplier="1.4" />
                </LinearLayout>
            </LinearLayout>

            <!-- Figuras -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/card_background"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextHeading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Figuras Coleccionables"
                        android:textSize="18sp"
                        android:textColor="@color/primaryOrange"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        style="@style/TextCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Figuras de acción, modelos estatuillas y collectibles premium de tus personajes favoritos."
                        android:textColor="@color/textSecondary"
                        android:lineSpacingMultiplier="1.4" />
                </LinearLayout>
            </LinearLayout>

            <!-- Merchandising -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/card_background"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextHeading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Merchandising"
                        android:textSize="18sp"
                        android:textColor="@color/primaryOrange"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        style="@style/TextCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Camisetas, mochilas, gorras, fundas y muchos más accesorios de tus animes favoritos."
                        android:textColor="@color/textSecondary"
                        android:lineSpacingMultiplier="1.4" />
                </LinearLayout>
            </LinearLayout>

            <!-- Footer -->
            <View
                android:layout_width="match_parent"
                android:layout_height="20dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
